# ── Database ─────────────────────────────────────────────
# Mode produksi (Cloudflare D1) — pakai ketiganya sekaligus:
CLOUDFLARE_API_TOKEN=
CF_ACCOUNT_ID=
CF_D1_ID=

# Alternatif: Turso/libSQL cloud (atau biarkan kosong → file SQLite lokal)
# TURSO_DATABASE_URL=libsql://...
# TURSO_AUTH_TOKEN=

# NEXT_PUBLIC_SITE_URL=https://pautin.xyc.my.id

# ── Login sosial (opsional; tombol muncul otomatis saat terisi) ──
# Google: https://console.cloud.google.com/apis/credentials → OAuth 2.0 Client ID (Web)
# redirect URI: https://pautin.xyc.my.id/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Discord: https://discord.com/developers/applications → OAuth2
# redirect URI: https://pautin.xyc.my.id/api/auth/discord/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# ── Cloudflare Turnstile (anti-bot daftar/masuk) ─────────
# Buat di dash.cloudflare.com → Turnstile. Jika dikosongkan, verifikasi dilewati (mode dev).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Email verifikasi (Resend) ───────────────────────────
# Wajib untuk kirim tautan verifikasi saat daftar.
# RESEND_API_KEY=re_...
# RESEND_FROM=Pautin <no-reply@domainmu.com>
